  class="card hidden">


  <div class="question-number">

    Question
    <span id="questionNumber"></span>
    of 10

  </div>


  <div class="progress">

    <div
      id="progressBar"
      class="progress-bar">
    </div>

  </div>


  <div
    id="questionText"
    class="question">
  </div>


  <!-- PREPARATION -->

  <div id="preparationArea">


    <div class="section">

      <h3>
        Useful Words
      </h3>

      <ul id="usefulWords"></ul>

    </div>


    <div class="section">

      <h3>
        Professional Phrases
      </h3>

      <ul id="professionalPhrases"></ul>

    </div>


    <div class="section">

      <h3>
        Thinking Points
      </h3>

      <ul id="thinkingPoints"></ul>

    </div>


    <div class="section">

      <h3>
        Preparation Time
      </h3>

      <p>
        Use this time to organise your thoughts.
        The suggestions are guidance.
        You do not need to use every word or phrase.
      </p>


      <div
        id="preparationCountdown"
        class="countdown">
      </div>

    </div>

