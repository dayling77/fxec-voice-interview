     COMPLETION
================================================== -->

<div
  id="completeCard"
  class="card hidden">

  <h2>
    Interview Completed
  </h2>

  <p>
    Your responses have been recorded successfully.
  </p>

  <div
    id="completionMessage"
    class="message success">
  </div>

</div>


</div>


<script>

/* =====================================================
   CONFIGURATION
===================================================== */


/*
 * IMPORTANT:
 *
 * Replace this with your actual
 * Apps Script Web App URL.
 *
 * Example:
 *
 * https://script.google.com/macros/s/XXXXXXXX/exec
 */

const APPS_SCRIPT_URL =
  'YOUR_APPS_SCRIPT_WEB_APP_URL';


/* =====================================================
   GLOBAL VARIABLES
===================================================== */

let student = null;

let questions = [];

let currentQuestionIndex = 0;

let attemptId = null;

let preparationTimer = null;

let answerTimer = null;

let preparationRemaining = 0;

let answerRemaining = 0;

let mediaRecorder = null;

let audioChunks = [];

let audioBlob = null;


/* =====================================================
   BACKEND REQUEST SYSTEM
===================================================== */

const pendingRequests = {};


let requestCounter = 0;


function backendRequest(
  action,
  payload
) {

  return new Promise(
    function(resolve, reject) {

      const requestId =
        'REQ-' +
        Date.now() +
        '-' +
        (++requestCounter);


      pendingRequests[
        requestId
      ] = {

        resolve:
          resolve,

        reject:
          reject

      };


      const bridge =
        document.getElementById(
          'backendBridge'
        );


      /*
       * Wait until the bridge is loaded.
       */

      if (
        bridge.contentWindow
      ) {

        bridge.contentWindow.postMessage(

          {

            source:
              'FXEC_MOCK_INTERVIEW',

            requestId:
              requestId,

            action:
              action,

            payload:
              payload || {}

          },

          '*'

        );

      }

    }
  );

}


/* =====================================================
   RECEIVE BACKEND RESPONSE
===================================================== */

window.addEventListener(
  'message',
  function(event) {

    if (
      !event.data ||
      event.data.source !==
        'FXEC_MOCK_INTERVIEW_BRIDGE'
    ) {

      return;

    }


    const data =
      event.data;


    const request =
      pendingRequests[
        data.requestId
      ];


    if (!request) {

      return;

    }


    delete pendingRequests[
      data.requestId
    ];


    if (data.success) {

      request.resolve(
        data.data
      );

    }

    else {

      request.reject(
        new Error(
          data.error ||
          'Backend request failed.'
        )
      );

    }

  }
);


/* =====================================================
   SHOW MESSAGE
===================================================== */

function showMessage(
  elementId,
  message,
  type
) {

  const element =
    document.getElementById(
      elementId
    );


  element.textContent =
    message;


  element.className =
    'message ' + type;


  element.classList.remove(
    'hidden'
  );

}


/* =====================================================
   SHOW / HIDE
===================================================== */

function show(
  elementId
) {

  document
    .getElementById(elementId)
    .classList
    .remove('hidden');

}


function hide(
  elementId
) {

  document
    .getElementById(elementId)
    .classList
    .add('hidden');

}


/* =====================================================
   VERIFY STUDENT
===================================================== */

async function verifyStudent() {

  const email =
    document
      .getElementById('email')
      .value
      .trim()
      .toLowerCase();


  if (!email) {

    showMessage(
      'loginMessage',
      'Please enter your college email address.',
      'error'
    );

    return;

  }


  const button =
    document.getElementById(
      'verifyBtn'
    );


  button.disabled =
    true;

  button.textContent =
    'Verifying...';


  try {

    const result =
      await backendRequest(

        'verifyStudent',

        {
          email:
            email
        }

      );


    if (!result.success) {

      throw new Error(
        result.message
      );

    }


    student =
      result;


    document.getElementById(
      'studentName'
    ).textContent =
      result.name;


    document.getElementById(
      'studentProgramme'
    ).textContent =
      result.programme;


    document.getElementById(
      'studentYear'
    ).textContent =
      result.year;


    document.getElementById(
      'studentSection'
    ).textContent =
      result.section;


    hide('loginCard');

    show('studentCard');

  }

  catch (error) {

    showMessage(
      'loginMessage',
      error.message ||
        'Unable to verify student.',
      'error'
    );

  }


  button.disabled =
    false;

  button.textContent =
    'Continue';

}


/* =====================================================
   BEGIN INTERVIEW
===================================================== */

async function beginInterview() {

  try {

    /*
     * Load exactly 10 questions.
     */

    questions =
      await backendRequest(

        'getInterviewQuestions',

        {
          programme:
            student.programme
        }

      );


    if (
      !questions ||
      questions.length !== 10
    ) {

      throw new Error(
        'Exactly 10 questions are required.'
      );

    }


    /*
     * Create attempt.
     */

    const attempt =
      await backendRequest(

        'createAttempt',

        {
          student:
            student
        }

      );


    attemptId =
      attempt.attemptId;


    hide('studentCard');

    show('interviewCard');


    currentQuestionIndex =
      0;


    showQuestion();

  }

  catch (error) {

    alert(
      error.message ||
      'Unable to start interview.'
    );

  }

}


/* =====================================================
   SHOW QUESTION
===================================================== */

function showQuestion() {

  clearTimers();


  audioBlob =
    null;

  audioChunks =
    [];


  const question =
    questions[
      currentQuestionIndex
    ];


  document.getElementById(
    'questionNumber'
  ).textContent =
    question.qNo;


  document.getElementById(
    'questionText'
  ).textContent =
    question.question;


  document.getElementById(
    'progressBar'
  ).style.width =

    (
      (
        currentQuestionIndex + 1
      )
      /
      10
      *
      100
    ) + '%';


  populateList(
    'usefulWords',
    question.usefulWords
  );


  populateList(
    'professionalPhrases',
    question.professionalPhrases
  );


  populateList(
    'thinkingPoints',
    question.thinkingPoints
  );


  show(
    'preparationArea'
  );


  hide(
    'recordingArea'
  );


  document.getElementById(
    'audioPlayback'
  ).classList.add(
    'hidden'
  );


  document.getElementById(
    'submitAnswerBtn'
  ).disabled =
    true;


  document.getElementById(
    'startBtn'
  ).disabled =
    true;


  document.getElementById(
    'stopBtn'
  ).disabled =
    true;


  startPreparationTimer(
    question.preparationTime
  );

}


/* =====================================================
   LIST DISPLAY
===================================================== */

function populateList(
  elementId,
  text
) {

  const list =
    document.getElementById(
      elementId
    );


  list.innerHTML =
    '';


  if (!text) {

    return;

  }


  const items =
    text
      .split(';')
      .map(
        function(item) {
          return item.trim();
        }
      )
      .filter(
        function(item) {
          return item;
        }
      );


  items.forEach(
    function(item) {

      const li =
        document.createElement(
          'li'
        );


      li.textContent =
        item;


      list.appendChild(
        li
      );

    }
  );

}


/* =====================================================
   PREPARATION TIMER
===================================================== */

function startPreparationTimer(
  seconds
) {

  preparationRemaining =
    Number(seconds) ||
    30;


  updatePreparationDisplay();


  preparationTimer =
    setInterval(
      function() {

        preparationRemaining--;


        updatePreparationDisplay();


        if (
          preparationRemaining <= 0
        ) {

          clearInterval(
            preparationTimer
          );


          startRecordingStage();

        }

      },
      1000
    );

}


/* =====================================================
   PREPARATION DISPLAY
===================================================== */

function updatePreparationDisplay() {

  document.getElementById(
    'preparationCountdown'
  ).textContent =
    preparationRemaining +
    ' sec';

}


/* =====================================================
   RECORDING STAGE
===================================================== */

function startRecordingStage() {

  show(
    'recordingArea'
  );


  document.getElementById(
    'recordingStatus'
  ).textContent =
    'Ready to record';


  document.getElementById(
    'startBtn'
  ).disabled =
    false;


  document.getElementById(
    'stopBtn'
  ).disabled =
    true;


  document.getElementById(
    'submitAnswerBtn'
  ).disabled =
    true;


  answerRemaining =
    Number(
      questions[
        currentQuestionIndex
      ].answerTime
    ) || 90;


  updateAnswerTimer();

}


/* =====================================================
   START RECORDING
===================================================== */

async function startRecording() {

  try {

    const stream =
      await navigator
        .mediaDevices
        .getUserMedia({
          audio: true
        });


    audioChunks =
      [];


    mediaRecorder =
      new MediaRecorder(
        stream
      );


    mediaRecorder.ondataavailable =
      function(event) {

        if (
          event.data &&
          event.data.size > 0
        ) {

          audioChunks.push(
            event.data
          );

        }

      };


    mediaRecorder.onstop =
      function() {

        audioBlob =
          new Blob(
            audioChunks,
            {
              type:
                'audio/webm'
            }
          );


        const audioURL =
          URL.createObjectURL(
            audioBlob
          );


        const audio =
          document.getElementById(
            'audioPlayback'
          );


        audio.src =
          audioURL;


        audio.classList.remove(
          'hidden'
        );


        document.getElementById(
          'submitAnswerBtn'
        ).disabled =
          false;

      };


    mediaRecorder.start();


    document.getElementById(
      'recordingStatus'
    ).textContent =
      '🔴 Recording...';


    document.getElementById(
      'startBtn'
    ).disabled =
      true;


    document.getElementById(
      'stopBtn'
    ).disabled =
      false;


    startAnswerTimer();

  }

  catch (error) {

    alert(
      'Microphone access is required. ' +
      'Please allow microphone permission ' +
      'for this GitHub Pages website.'
    );

  }

}


/* =====================================================
   STOP RECORDING
===================================================== */

function stopRecording() {

  if (!mediaRecorder) {

    return;

  }


  if (
    mediaRecorder.state !==
    'inactive'
  ) {

    mediaRecorder.stop();

  }


  if (
    mediaRecorder.stream
  ) {

    mediaRecorder.stream
      .getTracks()
      .forEach(
        function(track) {

          track.stop();

        }
      );

  }


  clearInterval(
    answerTimer
  );


  document.getElementById(
    'recordingStatus'
  ).textContent =
    'Recording completed';


  document.getElementById(
    'stopBtn'
  ).disabled =
    true;

}


/* =====================================================
   ANSWER TIMER
===================================================== */

function startAnswerTimer() {

  updateAnswerTimer();


  answerTimer =
    setInterval(
      function() {

        answerRemaining--;


        updateAnswerTimer();


        if (
          answerRemaining <= 0
        ) {

          clearInterval(
            answerTimer
          );


          stopRecording();

        }

      },
      1000
    );

}


/* =====================================================
   ANSWER TIMER DISPLAY
===================================================== */

function updateAnswerTimer() {

  const minutes =
    Math.floor(
      answerRemaining /
      60
    );


  const seconds =
    answerRemaining %
    60;


  document.getElementById(
    'answerTimer'
  ).textContent =

    String(minutes)
      .padStart(2, '0')

    + ':'

    +

    String(seconds)
      .padStart(2, '0');

}


/* =====================================================
   SUBMIT ANSWER
===================================================== */

async function submitAnswer() {

  if (!audioBlob) {

    alert(
      'Please record your answer before submitting.'
    );

    return;

  }


  const button =
    document.getElementById(
      'submitAnswerBtn'
    );


  button.disabled =
    true;


  button.textContent =
    'Preparing audio...';


  try {

    /*
     * Convert WebM audio to Base64.
     */

    const base64Audio =
      await blobToBase64(
        audioBlob
      );


    button.textContent =
      'Uploading audio...';


    /*
     * Upload to Drive through
     * Apps Script bridge.
     */

    const audioResult =
      await backendRequest(

        'uploadAudio',

        {

          base64Audio:
            base64Audio,

          attemptId:
            attemptId,

          qNo:
            questions[
              currentQuestionIndex
            ].qNo,

          email:
            student.email

        }

      );


    if (
      !audioResult ||
      !audioResult.success
    ) {

      throw new Error(
        'Audio upload failed.'
      );

    }


    button.textContent =
      'Saving response...';


    /*
     * Save response record.
     */

    const response = {

      attemptId:
        attemptId,

      email:
        student.email,

      qNo:
        questions[
          currentQuestionIndex
        ].qNo,

      question:
        questions[
          currentQuestionIndex
        ].question,

      transcript:
        '',

      content:
        '',

      vocabulary:
        '',

      phrases:
        '',

      grammar:
        '',

      pronunciation:
        '',

      fluency:
        '',

      clarity:
        '',

      totalScore:
        '',

      wordsToPractise:
        '',

      pronunciationFeedback:
        '',

      betterPhrases:
        '',

      aiFeedback:
        '',

      evaluationStatus:
        'Pending',

      audioFileUrl:
        audioResult.fileUrl

    };


    await backendRequest(

      'saveResponse',

      {
        response:
          response
      }

    );


    button.textContent =
      'Saved ✓';


    setTimeout(
      function() {

        moveToNextQuestion();

      },
      500
    );

  }

  catch (error) {

    button.disabled =
      false;


    button.textContent =
      'Submit Answer';


    alert(
      error.message ||
      'Unable to save answer.'
    );

  }

}


/* =====================================================
   BLOB TO BASE64
===================================================== */

function blobToBase64(
  blob
) {

  return new Promise(
    function(resolve, reject) {

      const reader =
        new FileReader();


      reader.onloadend =
        function() {

          const result =
            reader.result;


          const base64 =
            result.split(',')[1];


          resolve(
            base64
          );

        };


      reader.onerror =
        function() {

          reject(
            new Error(
              'Unable to read audio.'
            )
          );

        };


      reader.readAsDataURL(
        blob
      );

    }
  );

}


/* =====================================================
   NEXT QUESTION
===================================================== */

function moveToNextQuestion() {

  currentQuestionIndex++;


  if (
    currentQuestionIndex >=
    questions.length
  ) {

    finishInterview();

    return;

  }


  showQuestion();

}


/* =====================================================
   FINISH INTERVIEW
===================================================== */

async function finishInterview() {

  try {

    await backendRequest(

      'completeAttempt',

      {

        attemptId:
          attemptId,

        finalScore:
          ''

      }

    );


    hide(
      'interviewCard'
    );


    show(
      'completeCard'
    );


    document.getElementById(
      'completionMessage'
    ).textContent =

      'Attempt ' +
      attemptId +
      ' has been submitted successfully.';

  }

  catch (error) {

    alert(
      error.message ||
      'Unable to complete interview.'
    );

  }

}


/* =====================================================
   CLEAR TIMERS
===================================================== */

function clearTimers() {

  if (
    preparationTimer
  ) {

    clearInterval(
      preparationTimer
    );

    preparationTimer =
      null;

  }


  if (
    answerTimer
  ) {

    clearInterval(
      answerTimer
    );

    answerTimer =
      null;

  }

}

