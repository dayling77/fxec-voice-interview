</iframe>


<!-- =================================================
     HEADER
================================================== -->

<div class="header">

  <h1>
    FXEC AI Mock Interview
  </h1>

  <p>
    AI-Powered Employability & Communication Assessment
  </p>

</div>


<div class="container">


<!-- =================================================
     LOGIN
================================================== -->

<div
