<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0">

  <title>
    FXEC AI Mock Interview
  </title>

  <style>

    * {
      box-sizing: border-box;
    }


    body {

      margin: 0;

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      background:
        #f3f6fb;

      color:
        #172033;

    }


    .header {

      background:
        #062b63;

      color:
        white;

      padding:
        22px;

      text-align:
        center;

    }


    .header h1 {

      margin:
        0;

      font-size:
        25px;

    }


    .header p {

      margin:
        6px 0 0;

      opacity:
        .9;

    }


    .container {

      max-width:
        850px;

      margin:
        30px auto;

      padding:
        0 15px;

    }


    .card {

      background:
        white;

      border-radius:
        16px;

      padding:
        28px;

      box-shadow:
        0 5px 20px
        rgba(0,0,0,.08);

      margin-bottom:
        20px;

    }


    .hidden {

      display:
        none !important;

    }


    h2 {

      margin-top:
        0;

      color:
        #062b63;

    }


    input {

      width:
        100%;

      padding:
        14px;

      border:
        1px solid #ccd4e0;

      border-radius:
        8px;

      font-size:
        16px;

      margin:
        10px 0 15px;

    }


    button {

      border:
        none;

      border-radius:
        8px;

      padding:
        13px 22px;

      font-size:
        16px;

      cursor:
        pointer;

      font-weight:
        600;

    }


    button:disabled {

      opacity:
        .5;

      cursor:
        not-allowed;

    }


    .primary {

      background:
        #0756b5;

      color:
        white;

    }


    .danger {

      background:
        #c62828;

      color:
        white;

    }


    .student-info {

      display:
        grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap:
        12px;

      margin-top:
        20px;

    }


    .info-box {

      background:
        #f5f8fc;

      padding:
        14px;

      border-radius:
        8px;

    }


    .label {

      font-size:
        12px;

      color:
        #6b7280;

      text-transform:
        uppercase;

    }


    .value {

      font-weight:
        600;

      margin-top:
        4px;

    }


    .progress {

      height:
        10px;

      background:
        #e5e7eb;

      border-radius:
        10px;

      overflow:
        hidden;

      margin:
        15px 0 25px;

    }


    .progress-bar {

      height:
        100%;

      background:
        #0756b5;

      width:
        0%;

      transition:
        width .3s;

    }


    .question-number {

      font-size:
        14px;

      color:
        #0756b5;

      font-weight:
        bold;

      margin-bottom:
        10px;

    }


    .question {

      font-size:
        24px;

      line-height:
        1.4;

      font-weight:
        700;

      margin-bottom:
        25px;

    }


    .section {

      margin:
        18px 0;

      padding:
        16px;

      border-radius:
        10px;

      background:
        #f7f9fc;

    }


    .section h3 {

      margin:
        0 0 10px;

      font-size:
        15px;

      color:
        #0756b5;

    }


    .section ul {

      margin:
        0;

      padding-left:
        20px;

    }


    .section li {

      margin-bottom:
        6px;

    }


    .countdown {

      font-size:
        46px;

      font-weight:
        bold;

      text-align:
        center;

      color:
        #0756b5;

      margin:
        20px 0;

    }


    .timer {

      font-size:
        30px;

      font-weight:
        bold;

      text-align:
        center;

      margin:
        20px 0;

    }


    .recording-status {

      text-align:
        center;

      font-weight:
        bold;

      margin:
        15px 0;

    }


    .controls {

      display:
        flex;

      justify-content:
        center;

      gap:
        12px;

      flex-wrap:
        wrap;

      margin-top:
        20px;

    }


    audio {

      width:
        100%;

      margin-top:
        20px;

    }


    .message {

      padding:
        12px;

      border-radius:
        8px;

      margin-top:
        12px;

    }


    .error {

      background:
        #fee2e2;

      color:
        #991b1b;

    }


    .success {

      background:
        #dcfce7;

      color:
        #166534;

    }


    /*
     * Hidden Apps Script bridge.
     */

    #backendBridge {

      position:
        fixed;

      width:
        1px;

      height:
        1px;

      border:
        0;

      opacity:
        0;

      pointer-events:
        none;

      left:
        -9999px;

      top:
        -9999px;

    }


    @media (max-width:600px) {

      .card {
        padding:
          20px;
      }

      .student-info {
        grid-template-columns:
          1fr;
      }

      .question {
        font-size:
          20px;
      }

      .countdown {
        font-size:
          38px;
      }

    }

  </style>

</head>


<body>


<!-- =================================================
     HIDDEN APPS SCRIPT BACKEND
================================================== -->

<iframe
  id="backendBridge"
  src="YOUR_APPS_SCRIPT_WEB_APP_URL"
